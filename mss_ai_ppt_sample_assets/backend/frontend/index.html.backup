<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSS AI PPT | 智能报告生成器</title>
    <link rel="icon" type="image/svg+xml" href="assets/sangfor_logo_vector.svg">
    
    <style>
        /* --- CSS Reset & Variables --- */
        :root {
            /* Colors: Slate (Grays) */
            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-400: #94a3b8;
            --slate-500: #64748b;
            --slate-600: #475569;
            --slate-700: #334155;
            --slate-800: #1e293b;
            --slate-900: #0f172a;

            /* Colors: Brand (Indigo/Blue) */
            --brand-50: #eff6ff;
            --brand-100: #dbeafe;
            --brand-500: #3b82f6;
            --brand-600: #2563eb;
            --brand-700: #1d4ed8;

            /* Colors: Semantic */
            --danger-bg: #fef2f2;
            --danger-text: #991b1b;
            --success-text: #10b981;
            
            /* Dimensions */
            --header-height: 64px;
            --toolbar-height: 60px;
            --sidebar-width: 260px;
            --editor-width: 350px;
        }

        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft YaHei", Helvetica, Arial, sans-serif;
            background-color: var(--slate-50);
            color: var(--slate-900);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* App-like feel */
        }

        /* --- Typography --- */
        h1, h2, h3, h4, p { margin: 0; }
        .text-xs { font-size: 12px; }
        .text-sm { font-size: 14px; }
        .font-bold { font-weight: 600; }
        .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.05em; }
        .truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* --- Components: Layout --- */
        header {
            height: var(--header-height);
            background: rgba(255, 255, 255, 0.9);
            border-bottom: 1px solid var(--slate-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            flex-shrink: 0;
            backdrop-filter: blur(8px);
        }

        .logo-area { display: flex; align-items: center; gap: 12px; }
        .brand-logo {
            display: block;
            height: 60px;
            width: auto;
            object-fit: contain;
        }
        
        .toolbar {
            height: var(--toolbar-height);
            background: #fff;
            border-bottom: 1px solid var(--slate-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            flex-shrink: 0;
            z-index: 10;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }

        .main-container {
            flex: 1;
            display: flex;
            overflow: hidden;
            min-height: 0;
        }

        /* --- Sidebar (Left) --- */
        .sidebar {
            width: var(--sidebar-width);
            background: #fff;
            border-right: 1px solid var(--slate-200);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            z-index: 5;
        }
        
        .sidebar-header { padding: 12px 16px; border-bottom: 1px solid var(--slate-100); display: flex; justify-content: space-between; align-items: center; }
        .sidebar-content { flex: 1; overflow-y: auto; padding: 8px; }
        
        .slide-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px;
            border: 1px solid transparent;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 4px;
            background: #fff;
        }
        .slide-item:hover { border-color: var(--slate-200); background: var(--slate-50); }
        .slide-item.active {
            background: var(--brand-50);
            border-color: var(--brand-500);
        }
        .slide-num {
            width: 24px; height: 24px;
            background: var(--slate-100);
            color: var(--slate-500);
            border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: bold;
        }
        .slide-item.active .slide-num { background: var(--brand-500); color: white; }

        /* --- Canvas (Center) --- */
        .canvas-area {
            flex: 1;
            background-color: var(--slate-100);
            background-image: radial-gradient(var(--slate-300) 1px, transparent 1px);
            background-size: 20px 20px;
            display: flex;
            flex-direction: column;
            position: relative;
            min-width: 0;
        }
        
        .canvas-toolbar {
            height: 40px;
            background: #fff;
            border-bottom: 1px solid var(--slate-200);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 16px;
            flex-shrink: 0;
        }
        
        .canvas-viewport {
            flex: 1;
            overflow: auto;
            display: block; /* changed for scrolling list */
            padding: 32px;
            scroll-behavior: smooth;
        }

        .preview-list {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 48px;
            padding-bottom: 100px;
            min-height: 100%;
        }

        .slide-view-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: transform 0.2s;
        }

        .slide-view-label {
            font-size: 11px;
            color: var(--slate-500);
            font-weight: 600;
            text-align: center;
            opacity: 0.7;
        }

        .preview-card {
            background: white;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(0,0,0,0.05);
            width: auto;
            max-width: 100%;
            height: auto;
            max-height: 80vh; /* prevent too tall */
            display: block;
        }

        .placeholder-card {
            width: 800px; 
            max-width: 100%;
            aspect-ratio: 16/9;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--slate-300);
            font-size: 14px;
            border: 1px dashed var(--slate-300);
        }
        
        .empty-state {
            text-align: center;
            color: var(--slate-400);
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* --- Editor (Right) --- */
        .editor-panel {
            width: var(--editor-width);
            background: #fff;
            border-left: 1px solid var(--slate-200);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            box-shadow: -4px 0 15px rgba(0,0,0,0.02);
            z-index: 5;
        }
        
        .editor-header {
            padding: 12px 16px;
            background: var(--slate-50);
            border-bottom: 1px solid var(--slate-200);
            display: flex; justify-content: space-between; align-items: center;
        }
        
        textarea.code-editor {
            flex: 1;
            width: 100%;
            border: none;
            padding: 16px;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 12px;
            line-height: 1.5;
            resize: none;
            outline: none;
            color: var(--slate-700);
        }
        textarea.code-editor:focus { background-color: #fafafa; }

        /* --- Logs (Bottom Left) --- */
        .logs-section {
            border-top: 1px solid var(--slate-200);
            background: var(--slate-50);
        }
        .logs-toggle {
            width: 100%;
            padding: 10px 16px;
            border: none;
            background: none;
            text-align: left;
            cursor: pointer;
            display: flex; justify-content: space-between; align-items: center;
            font-size: 12px; font-weight: 600; color: var(--slate-600);
        }
        .logs-toggle:hover { background: var(--slate-100); }
        .logs-container {
            height: 150px;
            background: var(--slate-900);
            color: #10b981;
            overflow-y: auto;
            padding: 12px;
            font-family: monospace;
            font-size: 11px;
            display: none;
        }
        .logs-container.open { display: block; }

        /* --- UI Elements --- */
        select {
            padding: 8px 12px;
            border: 1px solid var(--slate-300);
            border-radius: 6px;
            font-size: 13px;
            background-color: var(--slate-50);
            min-width: 200px;
            outline: none;
        }
        select:focus { border-color: var(--brand-500); ring: 2px var(--brand-100); }
        
        button.btn-primary {
            background: var(--brand-600);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 8px;
            transition: background 0.2s;
        }
        button.btn-primary:hover { background: var(--brand-700); }
        button.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

        button.btn-secondary {
            background: #fff;
            color: var(--slate-700);
            border: 1px solid var(--slate-300);
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex; align-items: center; gap: 8px;
            transition: background 0.2s, border-color 0.2s;
        }
        button.btn-secondary:hover { background: var(--slate-50); border-color: var(--slate-400); }
        button.btn-secondary:disabled { opacity: 0.5; cursor: not-allowed; }

        button.btn-sm { padding: 4px 12px; font-size: 12px; }

        .badge {
            background: var(--slate-100);
            padding: 2px 8px;
            border-radius: 99px;
            font-size: 10px;
            color: var(--slate-500);
        }

        /* --- Loader --- */
        .spinner {
            width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* --- Scrollbars --- */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--slate-300); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--slate-400); }
        
        .hidden { display: none !important; }

        /* --- Compact Progress Bar --- */
        .progress-panel {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 360px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--slate-200);
            padding: 16px;
            z-index: 1000;
            display: none;
            animation: slideInUp 0.3s ease-out;
        }

        .progress-panel.active { display: block; }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .progress-panel-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .progress-panel-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--slate-700);
            flex: 1;
        }

        .progress-panel-close {
            background: none;
            border: none;
            color: var(--slate-400);
            cursor: pointer;
            padding: 4px;
            display: none;
        }

        .progress-panel-close:hover {
            color: var(--slate-600);
        }

        /* Compact Steps */
        .progress-steps-compact {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 12px;
        }

        .progress-step-compact {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 11px;
            transition: all 0.3s;
        }

        .progress-step-compact.pending {
            opacity: 0.3;
        }

        .progress-step-compact.active {
            opacity: 1;
        }

        .progress-step-compact.completed {
            opacity: 0.6;
        }

        .step-icon-compact {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .progress-step-compact.pending .step-icon-compact {
            background: var(--slate-100);
            color: var(--slate-400);
            border: 2px solid var(--slate-200);
        }

        .progress-step-compact.active .step-icon-compact {
            background: var(--brand-500);
            color: white;
            border: 2px solid var(--brand-600);
        }

        .progress-step-compact.completed .step-icon-compact {
            background: #10b981;
            color: white;
            border: 2px solid #059669;
        }

        .step-label-compact {
            flex: 1;
            font-weight: 500;
            color: var(--slate-700);
        }

        .step-spinner-compact {
            width: 12px;
            height: 12px;
            border: 2px solid white;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }

        /* Compact Progress Bar */
        .progress-bar-compact {
            background: var(--slate-100);
            height: 6px;
            border-radius: 99px;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .progress-bar-fill-compact {
            height: 100%;
            background: linear-gradient(90deg, var(--brand-500), var(--brand-600));
            border-radius: 99px;
            transition: width 0.5s ease;
            width: 0%;
        }

        .progress-percentage-compact {
            font-size: 11px;
            color: var(--slate-500);
            font-weight: 600;
            text-align: right;
        }

        /* --- Toast Notifications --- */
        .toast-container {
            position: fixed;
            top: 80px;
            right: 24px;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }

        .toast {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--slate-200);
            padding: 16px 20px;
            min-width: 320px;
            max-width: 420px;
            display: flex;
            align-items: center;
            gap: 12px;
            pointer-events: auto;
            animation: slideInRight 0.3s ease-out;
            transition: opacity 0.3s, transform 0.3s;
        }

        .toast.toast-success {
            border-left: 4px solid #10b981;
        }

        .toast.toast-error {
            border-left: 4px solid #ef4444;
        }

        .toast.toast-info {
            border-left: 4px solid var(--brand-500);
        }

        .toast.toast-warning {
            border-left: 4px solid #f59e0b;
        }

        .toast.removing {
            opacity: 0;
            transform: translateX(100px);
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .toast-icon {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 14px;
        }

        .toast-success .toast-icon {
            background: #d1fae5;
            color: #10b981;
        }

        .toast-error .toast-icon {
            background: #fee2e2;
            color: #ef4444;
        }

        .toast-info .toast-icon {
            background: var(--brand-100);
            color: var(--brand-600);
        }

        .toast-warning .toast-icon {
            background: #fef3c7;
            color: #f59e0b;
        }

        .toast-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toast-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--slate-900);
        }

        .toast-message {
            font-size: 12px;
            color: var(--slate-600);
            line-height: 1.4;
        }

        .toast-close {
            background: none;
            border: none;
            color: var(--slate-400);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            transition: background 0.2s;
        }

        .toast-close:hover {
            background: var(--slate-100);
            color: var(--slate-600);
        }

        /* Rating Card Styles */
        .rating-card {
            position: fixed;
            bottom: 16px;
            right: 16px;
            z-index: 1000;
            background: white;
            border-radius: 10px;
            width: 340px;
            max-width: calc(100vw - 32px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
            animation: slideInFromRight 0.3s ease;
        }

        @keyframes slideInFromRight {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .rating-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px 10px;
            border-bottom: 1px solid var(--slate-200);
        }

        .rating-card-header h4 {
            font-size: 15px;
            font-weight: 600;
            color: var(--slate-900);
            margin: 0;
        }

        .rating-card-close {
            background: none;
            border: none;
            font-size: 18px;
            color: var(--slate-400);
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .rating-card-close:hover {
            background: var(--slate-100);
            color: var(--slate-600);
        }

        .rating-card-body {
            padding: 16px;
        }

        .rating-card-body > p.rating-prompt {
            margin: 0 0 12px 0;
            color: var(--slate-600);
            font-size: 13px;
            line-height: 1.4;
        }

        .rating-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 14px;
        }

        .rating-btn {
            flex: 1;
            padding: 12px 8px;
            border: 2px solid var(--slate-200);
            background: white;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .rating-btn:hover {
            border-color: var(--brand-500);
            background: var(--brand-50);
        }

        .rating-btn.selected {
            border-color: var(--brand-600);
            background: var(--brand-50);
        }

        .rating-icon {
            font-size: 28px;
        }

        .rating-btn span:last-child {
            font-size: 13px;
            font-weight: 500;
            color: var(--slate-700);
        }

        #ratingCommentSection {
            margin-bottom: 14px;
        }

        #ratingCommentSection label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 500;
            color: var(--slate-700);
        }

        .rating-required {
            color: #dc2626;
            font-size: 11px;
            font-weight: normal;
        }

        #ratingComment {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--slate-300);
            border-radius: 6px;
            font-size: 13px;
            font-family: inherit;
            resize: vertical;
            box-sizing: border-box;
        }

        #ratingComment:focus {
            outline: none;
            border-color: var(--brand-500);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .rating-char-count {
            text-align: right;
            font-size: 11px;
            color: var(--slate-400);
            margin-top: 4px;
        }

        .rating-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        .rating-error {
            margin-top: 12px;
            padding: 12px;
            background: var(--danger-bg);
            color: var(--danger-text);
            border-radius: 6px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <!-- Toast Container (Top Right) -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Compact Progress Panel (Bottom Right) -->
    <div id="progressPanel" class="progress-panel">
        <div class="progress-panel-header">
            <div class="progress-panel-title" data-i18n="msgGenerating">正在生成报告</div>
            <button id="progressClose" class="progress-panel-close">✕</button>
        </div>

        <div class="progress-steps-compact" id="progressStepsCompact">
            <!-- Steps will be injected here -->
        </div>

        <div class="progress-bar-compact">
            <div class="progress-bar-fill-compact" id="progressBarFillCompact"></div>
        </div>
        <div class="progress-percentage-compact" id="progressPercentageCompact">0%</div>
    </div>

    <!-- Header -->
    <header>
        <div class="logo-area">
            <img class="brand-logo" src="assets/sangfor_logo_vector.svg" alt="Sangfor Logo">
            <div>
                <h1 style="font-size: 16px; font-weight: 700;">MSS AI PPT</h1>
                <div style="font-size: 10px; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.5px;" data-i18n="pageSubtitle">智能报告生成器</div>
            </div>
        </div>

        <!-- Language Switcher -->
        <div style="display: flex; gap: 8px; align-items: center;">
            <span style="font-size: 12px; color: var(--slate-500); margin-right: 4px;" data-i18n="langSwitcher">语言</span>
            <button
                onclick="switchLanguage('zh-CN')"
                id="langBtnZh"
                style="padding: 6px 12px; border: 1px solid var(--slate-300); background: white; cursor: pointer; border-radius: 6px; font-size: 13px; transition: all 0.2s;">
                中文
            </button>
            <button
                onclick="switchLanguage('en-US')"
                id="langBtnEn"
                style="padding: 6px 12px; border: 1px solid var(--slate-300); background: white; cursor: pointer; border-radius: 6px; font-size: 13px; transition: all 0.2s;">
                English
            </button>
        </div>
        <div style="display: flex; gap: 12px; align-items: center;">
            <div style="font-size: 12px; color: var(--slate-400);">v0.1.0-beta</div>
            <div style="width: 8px; height: 8px; background: #10b981; border-radius: 50%;"></div>
        </div>
    </header>

    <!-- Toolbar -->
    <div class="toolbar">
        <div style="display: flex; gap: 20px; align-items: center;">
            <div>
                <div class="text-xs uppercase font-bold" style="color: var(--slate-400); margin-bottom: 4px;" data-i18n="labelInput">输入数据</div>
                <select id="inputSelect"><option data-i18n="msgLoading">加载中...</option></select>
            </div>
            <div style="width: 1px; height: 32px; background: var(--slate-200);"></div>
            <div>
                <div class="text-xs uppercase font-bold" style="color: var(--slate-400); margin-bottom: 4px;" data-i18n="labelTemplate">选择模板</div>
                <select id="templateSelect"><option data-i18n="msgLoading">加载中...</option></select>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 16px;">
            <label style="font-size: 12px; color: var(--slate-600); display: flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="useMock" checked>
                <span data-i18n="labelUseMock">快速生成 (Mock)</span>
            </label>
            <button id="downloadBtn" class="btn-secondary" disabled>
                <span data-i18n="btnDownload">下载 PPT</span>
            </button>
            <button id="downloadPdfBtn" class="btn-secondary" disabled>
                <span data-i18n="btnDownloadPdf">下载 PDF</span>
            </button>
            <button id="generateBtn" class="btn-primary">
                <span id="genIcon">
                   <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </span>
                <span id="genSpinner" class="spinner hidden"></span>
                <span data-i18n="btnGenerate">生成报告</span>
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-container">
        
        <!-- Left Sidebar -->
        <div class="sidebar">
            <div class="sidebar-header">
                <span class="text-xs font-bold uppercase" style="color: var(--slate-500);" data-i18n="sectionSlides">幻灯片列表</span>
                <span id="slideCount" class="badge">0</span>
            </div>
            <div id="slidesList" class="sidebar-content">
                <div class="empty-state" style="margin-top: 40px;">
                    <div style="font-size: 12px;" data-i18n="msgNoData">暂无幻灯片</div>
                </div>
            </div>

            <div class="logs-section">
                <button id="toggleLogsBtn" class="logs-toggle">
                    <span data-i18n="sectionLogs">系统日志</span>
                    <span id="logArrow" style="transition: transform 0.2s;">▲</span>
                </button>
                <div id="logContainer" class="logs-container">
                    <div id="logsContent">等待日志...</div>
                </div>
            </div>
        </div>

        <!-- Center Canvas -->
        <div class="canvas-area">
            <div class="canvas-toolbar">
                <span id="activeSlideTitle" style="font-size: 12px; font-weight: 600; color: var(--slate-700);">总览</span>
                <button id="refreshPreviewBtn" style="background:none; border:none; color: var(--brand-600); font-size: 12px; font-weight: 600; cursor: pointer;" data-i18n="btnRefreshPreview">
                    刷新预览
                </button>
            </div>
            
            <div id="canvasViewport" class="canvas-viewport">
                <div id="previewList" class="preview-list hidden">
                    <!-- Slides injected here -->
                </div>
                <div id="emptyState" class="empty-state">
                    <div style="font-size: 40px; color: var(--slate-300); margin-bottom: 16px;">▨</div>
                    <div style="font-size: 14px; font-weight: 500; color: var(--slate-500);" data-i18n="msgSelectDataAndTemplate">请选择数据和模板以开始</div>
                </div>
            </div>

            <div style="padding: 6px 16px; background: #fff; border-top: 1px solid var(--slate-200); font-size: 10px; color: var(--slate-400); display: flex; justify-content: space-between;">
                <span id="jobIdDisplay" data-i18n="msgNoJob">任务ID: 无</span>
                <span>1920 x 1080</span>
            </div>
        </div>

        <!-- Right Editor -->
        <div class="editor-panel">
            <div class="editor-header">
                <span class="text-xs font-bold uppercase" style="color: var(--slate-500);" data-i18n="editorTitle">JSON 属性编辑器</span>
                <button id="rewriteBtn" class="btn-primary btn-sm" data-i18n="btnApplyRegenerate">应用并重新生成</button>
            </div>

            <!-- Info banner -->
            <div style="background: var(--brand-50); border-bottom: 1px solid var(--brand-200); padding: 10px 16px; display: flex; gap: 10px; align-items: start;">
                <div style="color: var(--brand-600); font-size: 14px; flex-shrink: 0;">ℹ</div>
                <div style="font-size: 11px; color: var(--brand-700); line-height: 1.4;" data-i18n="editorHint">
                    <strong>编辑提示：</strong>只能修改字段的<strong>值</strong>，不能修改字段名（如TITLE、SUBTITLE等）。删除或重命名字段将被忽略。
                </div>
            </div>

            <textarea id="slideJson" class="code-editor" spellcheck="false" data-i18n-placeholder="editorPlaceholder"></textarea>
            <div style="padding: 8px 16px; background: var(--slate-50); border-top: 1px solid var(--slate-200); font-size: 10px; color: var(--slate-400); text-align: right;">
                JSON 格式
            </div>
        </div>
    </div>

    <!-- Rating Card (Bottom Right) -->
    <div id="ratingCard" class="rating-card" style="display: none;">
        <div class="rating-card-header">
            <h4 data-i18n="ratingTitle">为这份报告评分</h4>
            <button class="rating-card-close" onclick="closeRatingCard()">&times;</button>
        </div>
        <div class="rating-card-body">
            <p class="rating-prompt" data-i18n="ratingPrompt">PPT已开始下载，请问这份报告是否基本可用？</p>

            <div class="rating-buttons">
                <button class="rating-btn" data-rating="liked" onclick="selectRating('liked')">
                    <span class="rating-icon">👍</span>
                    <span data-i18n="ratingLiked">满意</span>
                </button>
                <button class="rating-btn" data-rating="disliked" onclick="selectRating('disliked')">
                    <span class="rating-icon">👎</span>
                    <span data-i18n="ratingDisliked">不满意</span>
                </button>
            </div>

            <div id="ratingCommentSection" style="display: none;">
                <label for="ratingComment">
                    <span data-i18n="ratingCommentLabel">请告诉我们具体的问题</span>
                    <span class="rating-required">(必填，至少10个字)</span>
                </label>
                <textarea
                    id="ratingComment"
                    rows="3"
                    maxlength="500"
                    data-i18n-placeholder="ratingCommentPlaceholder"
                ></textarea>
                <div class="rating-char-count">
                    <span id="ratingCharCount">0</span> / 500
                </div>
            </div>

            <div class="rating-actions" id="ratingActions">
                <button class="btn-primary" id="submitRatingBtn" onclick="submitRating()" style="display: none;" data-i18n="ratingSubmit">提交评分</button>
            </div>

            <div id="ratingError" class="rating-error" style="display: none;"></div>
        </div>
    </div>

    <!-- Logic -->
    <script>
        // --- i18n System ---
        let currentLang = localStorage.getItem('lang') || 'zh-CN';
        let translations = {};

        async function loadTranslations(lang) {
            try {
                const response = await fetch(`/i18n/${lang}.json`);
                translations = await response.json();
                return true;
            } catch (e) {
                console.error('Failed to load translations:', e);
                return false;
            }
        }

	        function t(key) {
	            return translations[key] || key;
	        }

	        function tf(key, params = {}) {
	            let template = t(key);
	            for (const [name, value] of Object.entries(params)) {
	                const token = `{${name}}`;
	                template = template.split(token).join(String(value));
	            }
	            return template;
	        }

        function switchLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);
            loadTranslations(lang).then(() => {
                updateUILanguage();
                updateLanguageButtonStyles();
            });
        }

        function updateLanguageButtonStyles() {
            const zhBtn = document.getElementById('langBtnZh');
            const enBtn = document.getElementById('langBtnEn');

            if (currentLang === 'zh-CN') {
                zhBtn.style.background = 'var(--brand-500)';
                zhBtn.style.color = 'white';
                zhBtn.style.borderColor = 'var(--brand-500)';
                enBtn.style.background = 'white';
                enBtn.style.color = 'var(--slate-700)';
                enBtn.style.borderColor = 'var(--slate-300)';
            } else {
                enBtn.style.background = 'var(--brand-500)';
                enBtn.style.color = 'white';
                enBtn.style.borderColor = 'var(--brand-500)';
                zhBtn.style.background = 'white';
                zhBtn.style.color = 'var(--slate-700)';
                zhBtn.style.borderColor = 'var(--slate-300)';
            }
        }

        function updateUILanguage() {
            // Update all elements with data-i18n attribute
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                el.textContent = t(key);
            });

            // Update placeholders
            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                el.placeholder = t(key);
            });

            // Update title attributes (tooltips)
            document.querySelectorAll('[data-i18n-title]').forEach(el => {
                const key = el.getAttribute('data-i18n-title');
                el.title = t(key);
            });

            // Update page title
            document.title = t('pageTitle');

            // Update progress steps
            if (state.progressSteps.length > 0) {
                updateProgressStepsLanguage();
            }

            // Update dropdowns if loaded
            updateInputDropdown();
            updateTemplateDropdown();

            // Update modified slides button
            updateModifiedSlidesUI();
        }

        function getTemplateNameTranslated(templateId, originalName) {
            // Map template IDs to translation keys
            const templateKeyMap = {
                'mss_executive_v2': 'templateExecutive',
                'mss_technical_v2': 'templateTechnical'
            };

            const key = templateKeyMap[templateId];
            if (key && translations[key]) {
                return translations[key];
            }
            return originalName; // Fallback to original name
        }

        function updateTemplateDropdown() {
            const tplSel = $('templateSelect');
            if (!tplSel || !window.cachedTemplates) return;

            const currentValue = tplSel.value;
            tplSel.innerHTML = `<option value="">${t('msgSelectTemplate')}</option>`;

            window.cachedTemplates.forEach(tpl => {
                const opt = document.createElement('option');
                opt.value = tpl.template_id;
                opt.textContent = getTemplateNameTranslated(tpl.template_id, tpl.name);
                tplSel.appendChild(opt);
            });

            // Restore selection
            if (currentValue) {
                tplSel.value = currentValue;
            }
        }

        function updateInputDropdown() {
            const inputSel = $('inputSelect');
            if (!inputSel || !window.cachedInputs) return;

            const currentValue = inputSel.value;
            inputSel.innerHTML = `<option value="">${t('msgSelectDataSource')}</option>`;

            window.cachedInputs.forEach(i => {
                const opt = document.createElement('option');
                opt.value = i.id;
                opt.textContent = `${i.tenant_name || i.id} (${i.period})`;
                inputSel.appendChild(opt);
            });

            // Restore selection
            if (currentValue) {
                inputSel.value = currentValue;
            }
        }

        function updateProgressStepsLanguage() {
            const stepTranslations = {
                'init': t('progressInit'),
                'load_template': t('progressLoadTemplate'),
                'generate_content': t('progressGenerateContent'),
                'render_ppt': t('progressRenderPpt'),
                'complete': t('progressComplete')
            };

            state.progressSteps.forEach(step => {
                if (stepTranslations[step.id]) {
                    step.label = stepTranslations[step.id];
                }
            });

            if (state.progressSteps.length > 0) {
                renderProgressSteps();
            }
        }

        const state = {
            jobId: null,
            slidespec: null,
            previews: [],
            activeSlideKey: null,
            loading: false,
            logsVisible: false,
            isClickScrolling: false, // flag to prevent intersection observer conflict
            websocket: null,
            clientId: null,
            sessionId: null,
            progressSteps: [],
            wsReady: false,  // Track if WebSocket is ready
            modifiedSlides: new Map()  // Track all modified slides: Map<slide_key, new_content>
        };

        const $ = (id) => document.getElementById(id);

        // --- Toast Notification System ---
        function showToast(message, options = {}) {
            const {
                type = 'info',  // 'success', 'error', 'warning', 'info'
                title = '',
                duration = 4000,  // Auto-dismiss after 4 seconds
                closable = true
            } = options;

            const container = $('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            // Icon mapping
            const icons = {
                success: '✓',
                error: '✕',
                warning: '!',
                info: 'i'
            };

            const icon = icons[type] || icons.info;

            // Build toast HTML
            let html = `
                <div class="toast-icon">${icon}</div>
                <div class="toast-content">
            `;

            if (title) {
                html += `<div class="toast-title">${title}</div>`;
            }

            html += `<div class="toast-message">${message}</div>`;
            html += `</div>`;

            if (closable) {
                html += `<button class="toast-close">✕</button>`;
            }

            toast.innerHTML = html;
            container.appendChild(toast);

            // Close button handler
            if (closable) {
                const closeBtn = toast.querySelector('.toast-close');
                closeBtn.onclick = () => removeToast(toast);
            }

            // Auto-dismiss
            if (duration > 0) {
                setTimeout(() => removeToast(toast), duration);
            }

            return toast;
        }

        function removeToast(toast) {
            toast.classList.add('removing');
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);  // Match CSS transition duration
        }

        // Convenience methods
        const toast = {
            success: (message, title) => showToast(message, { type: 'success', title }),
            error: (message, title) => showToast(message, { type: 'error', title, duration: 6000 }),
            warning: (message, title) => showToast(message, { type: 'warning', title }),
            info: (message, title) => showToast(message, { type: 'info', title })
        };

        // --- WebSocket Connection ---
        function initWebSocket() {
            // Generate unique client ID
            state.clientId = 'client_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${protocol}//${window.location.host}/ws/${state.clientId}`;

            console.log('Connecting to WebSocket:', wsUrl);

            state.websocket = new WebSocket(wsUrl);

            state.websocket.onopen = () => {
                console.log('WebSocket connected:', state.clientId);
                state.wsReady = true;  // Mark as ready
            };

            state.websocket.onmessage = (event) => {
                const data = JSON.parse(event.data);
                console.log('WebSocket message:', data);
                handleWebSocketMessage(data);
            };

            state.websocket.onerror = (error) => {
                console.error('WebSocket error:', error);
                state.wsReady = false;
            };

            state.websocket.onclose = () => {
                console.log('WebSocket closed, reconnecting in 3s...');
                state.wsReady = false;
                setTimeout(initWebSocket, 3000);
            };
        }

        function handleWebSocketMessage(data) {
            switch(data.type) {
                case 'connected':
                    console.log('Connected to server');
                    break;

                case 'progress':
                    updateProgress(data.progress, data.message, data.details);
                    break;

                case 'step_update':
                    updateStep(data.step_id, data.status, data.message);
                    break;

                case 'completed':
                    handleGenerationComplete(data.result);
                    break;

                case 'failed':
                    handleGenerationFailed(data.result);
                    break;
            }
        }

        // --- Progress UI Management ---
        const PROGRESS_STEPS = [
            { id: 'init', label: 'progressInit' },
            { id: 'load_template', label: 'progressLoadTemplate' },
            { id: 'generate_content', label: 'progressGenerateContent' },
            { id: 'render_ppt', label: 'progressRenderPpt' },
            { id: 'complete', label: 'progressComplete' }
        ];

        function showProgressPanel() {
            state.progressSteps = PROGRESS_STEPS.map(s => ({ ...s, status: 'pending' }));
            renderProgressSteps();
            $('progressPanel').classList.add('active');
            updateProgressBar(0);
        }

        function hideProgressPanel() {
            setTimeout(() => {
                $('progressPanel').classList.remove('active');
            }, 2000);
        }

        function renderProgressSteps() {
            const container = $('progressStepsCompact');
            container.innerHTML = state.progressSteps.map((step, idx) => `
                <div class="progress-step-compact ${step.status}" data-step-id="${step.id}">
                    <div class="step-icon-compact">
                        ${step.status === 'active' ? '<div class="step-spinner-compact"></div>' :
                          step.status === 'completed' ? '✓' : (idx + 1)}
                    </div>
                    <div class="step-label-compact">${t(step.label)}</div>
                </div>
            `).join('');
        }

        function updateStep(stepId, status) {
            const step = state.progressSteps.find(s => s.id === stepId);
            if (step) {
                step.status = status;
                renderProgressSteps();
            }
        }

        function updateProgress(progress, message, details) {
            updateProgressBar(progress);

            // Map progress percentage to step index based on actual backend progress ranges
            // 0-20: init, 20-30: load_template, 30-70: generate_content, 70-90: render_ppt, 90-100: complete
            let currentStepIndex = 0;
            if (progress < 20) {
                currentStepIndex = 0; // init
            } else if (progress < 30) {
                currentStepIndex = 1; // load_template
            } else if (progress < 70) {
                currentStepIndex = 2; // generate_content
            } else if (progress < 90) {
                currentStepIndex = 3; // render_ppt
            } else {
                currentStepIndex = 4; // complete
            }

            // Mark previous steps as completed
            for (let i = 0; i < currentStepIndex; i++) {
                if (state.progressSteps[i].status !== 'completed') {
                    state.progressSteps[i].status = 'completed';
                }
            }

            // Mark current step as active
            if (state.progressSteps[currentStepIndex]) {
                state.progressSteps[currentStepIndex].status = 'active';
            }

            renderProgressSteps();
        }

        function updateProgressBar(progress) {
            $('progressBarFillCompact').style.width = progress + '%';
            $('progressPercentageCompact').textContent = Math.round(progress) + '%';
        }

        function handleGenerationComplete(result) {
            // Mark all steps as completed
            state.progressSteps.forEach(s => s.status = 'completed');
            renderProgressSteps();
            updateProgressBar(100);

            // Clear modified slides on new generation
            state.modifiedSlides.clear();

            // Clear session_id so next generation creates a new one (for idempotency)
            state.sessionId = null;
            console.log('Job completed, cleared session_id for next generation');

            // Update state with result
            if (result.job_id) {
                state.jobId = result.job_id;
                state.slidespec = result.slidespec;
                $('jobIdDisplay').textContent = t('msgJobId') + ": " + result.job_id;
                syncActionButtons();

                if (result.slidespec && result.slidespec.slides && result.slidespec.slides.length) {
                    state.activeSlideKey = result.slidespec.slides[0].slide_key;
                }

                renderSlides();
                renderPreviewList();

                // IMPORTANT: Update editor JSON to match new slidespec to avoid false "added fields" warnings
                // This prevents the editor from showing old JSON while state.slidespec has new data
                if (state.activeSlideKey) {
                    const slide = state.slidespec.slides.find(s => s.slide_key === state.activeSlideKey);
                    if (slide) {
                        $('slideJson').value = JSON.stringify(slide.placeholders || {}, null, 2);
                    }
                }

                // Fetch previews
                setTimeout(async () => {
                    try {
                        const prevRes = await api(`/api/v1/reports/${encodeURIComponent(result.job_id)}/preview?regenerate_if_missing=true`);
                        const prevData = prevRes.data || prevRes;
                        state.previews = prevData.preview_urls || prevData.images || [];
                        renderPreviewList();
                        updateActiveState(state.activeSlideKey, true);

                        // Update logs
                        const l = await api('/api/v1/system/logs?limit=20');
                        const logData = l.data || l;
                        renderLogs(logData.lines || []);
                    } catch (e) {
                        console.error('Failed to load previews:', e);
                    }
                }, 500);
            }

            hideProgressPanel();
        }

	        function handleGenerationFailed(result) {
	            // Clear session_id so next generation creates a new one (for idempotency)
	            state.sessionId = null;
	            console.log('Job failed, cleared session_id for retry');

	            toast.error(result.error || t('errorUnknown'), t('msgError'));
	            hideProgressPanel();
	        }

        // --- Cooldown Management ---
        function checkAndRestoreCooldown() {
            const cooldownEnd = parseInt(localStorage.getItem('generateCooldownEnd') || '0');
            const now = Date.now();

            if (cooldownEnd > now) {
                // Still in cooldown period, restore countdown
                const btn = $('generateBtn');
                if (!btn) {
                    console.warn('Generate button not found, skipping cooldown restore');
                    return;
                }

                const cooldownInterval = setInterval(() => {
                    const cooldownEnd = parseInt(localStorage.getItem('generateCooldownEnd') || '0');
                    const remaining = Math.ceil((cooldownEnd - Date.now()) / 1000);
                    const btnTextSpan = btn.querySelector('[data-i18n="btnGenerate"]');

                    if (remaining <= 0) {
                        clearInterval(cooldownInterval);
                        localStorage.removeItem('generateCooldownEnd');
                        if (btnTextSpan) btnTextSpan.textContent = t('btnGenerate');
                    } else {
                        if (btnTextSpan) btnTextSpan.textContent = `${t('btnGenerate')} (${remaining}${t('msgRetryIn')})`;
                    }
                }, 1000);

                // Update immediately
                const remaining = Math.ceil((cooldownEnd - now) / 1000);
                const btnTextSpan = btn.querySelector('[data-i18n="btnGenerate"]');
                if (btnTextSpan) btnTextSpan.textContent = `${t('btnGenerate')} (${remaining}${t('msgRetryIn')})`;
            }
        }

        // --- API Client ---
        async function api(path, opts = {}) {
            const res = await fetch(path, { headers: { 'Content-Type': 'application/json' }, ...opts });
            if (!res.ok) {
                // 尝试解析 JSON 错误响应
                const errorData = await res.json().catch(() => null);
                const error = new Error(errorData?.error?.message || res.statusText);
                error.data = errorData;  // 保存完整错误信息
                throw error;
            }
            return await res.json();
        }

        // --- Init ---
        async function init() {
            // Load translations first
            await loadTranslations(currentLang);
            updateUILanguage();
            updateLanguageButtonStyles();

            // Initialize WebSocket
            initWebSocket();

            // Check for existing cooldown on page load
            checkAndRestoreCooldown();

            try {
                const [tplsResp, inputsResp, logsResp] = await Promise.all([
                    api('/api/v1/templates'),
                    api('/api/v1/inputs'),
                    api('/api/v1/system/logs?limit=20')
                ]);

                // Extract data from new response format
                const tpls = tplsResp.data || tplsResp;
                const inputs = inputsResp.data || inputsResp;
                const logs = logsResp.data || logsResp;

                // Cache templates and inputs for language switching
                window.cachedTemplates = tpls;
                window.cachedInputs = inputs;

                const inputSel = $('inputSelect');
                inputSel.innerHTML = `<option value="">${t('msgSelectDataSource')}</option>`;
                inputs.forEach(i => {
                    const opt = document.createElement('option');
                    opt.value = i.id;
                    opt.textContent = `${i.tenant_name || i.id} (${i.period})`;
                    inputSel.appendChild(opt);
                });

                const tplSel = $('templateSelect');
                tplSel.innerHTML = `<option value="">${t('msgSelectTemplate')}</option>`;
                tpls.forEach(tpl => {
                    const opt = document.createElement('option');
                    opt.value = tpl.template_id;
                    opt.textContent = getTemplateNameTranslated(tpl.template_id, tpl.name);
                    tplSel.appendChild(opt);
                });

                renderLogs(logs.lines || []);
            } catch (e) { console.error(e); }
        }

        // --- Intersection Observer for Scroll Sync ---
        const observer = new IntersectionObserver((entries) => {
            if (state.isClickScrolling) return;

            // Find the entry with largest intersection ratio
            let maxRatio = 0;
            let maxEntry = null;
            
            entries.forEach(e => {
                if(e.intersectionRatio > maxRatio) {
                    maxRatio = e.intersectionRatio;
                    maxEntry = e;
                }
            });

            if (maxEntry && maxRatio > 0.4) { // 40% visible
                const key = maxEntry.target.dataset.key;
                if (key && key !== state.activeSlideKey) {
                    updateActiveState(key, false); // false = do not scroll right view
                }
            }
        }, {
            root: $('canvasViewport'),
            threshold: [0.1, 0.4, 0.6, 0.8]
        });

        // --- Renderers ---
        function renderLogs(lines) {
            const container = $('logsContent');
            if (!lines.length) {
                container.innerHTML = '<span style="opacity:0.5">暂无日志。</span>';
                return;
            }
            container.innerHTML = lines.map((l, i) => 
                `<div><span style="opacity:0.3; margin-right:8px;">${i+1}</span>${l}</div>`
            ).join('');
            $('logContainer').scrollTop = $('logContainer').scrollHeight;
        }

        function renderSlides() {
            const list = $('slidesList');
            const slides = state.slidespec?.slides || [];
            $('slideCount').textContent = slides.length;
            
            if (!slides.length) {
                list.innerHTML = '<div class="empty-state" style="margin-top:40px;"><div style="font-size:12px;">暂无幻灯片</div></div>';
                return;
            }

            // Only rebuild list if count changes or force update needed. 
            // For simplicity, we rebuild but try to maintain scroll pos if possible? 
            // Actually, rebuilding is fine for this scale.
            list.innerHTML = '';
            slides.forEach((s, idx) => {
                const div = document.createElement('div');
                div.className = 'slide-item';
                div.dataset.key = s.slide_key; // For selector lookup
                div.onclick = () => updateActiveState(s.slide_key, true); // true = click scroll
                div.innerHTML = `
                    <div class="slide-num">${idx + 1}</div>
                    <div style="flex:1; overflow:hidden;">
                        <div class="text-sm font-bold truncate">${s.slide_key}</div>
                    </div>
                `;
                list.appendChild(div);
            });
            
            // Highlight current
            highlightSidebar(state.activeSlideKey);
        }

        function renderPreviewList() {
            const list = $('previewList');
            const slides = state.slidespec?.slides || [];
            
            if (!slides.length) {
                list.classList.add('hidden');
                $('emptyState').classList.remove('hidden');
                return;
            }

            list.innerHTML = '';
            
            slides.forEach((s, idx) => {
                const imgUrl = state.previews[idx];
                const viewItem = document.createElement('div');
                viewItem.className = 'slide-view-item';
                viewItem.id = 'view-' + s.slide_key;
                viewItem.dataset.key = s.slide_key;

                const label = document.createElement('div');
                label.className = 'slide-view-label';
                label.textContent = `${t('msgPageNumber')} ${idx+1} ${t('msgPage')}: ${s.slide_key}`;
                viewItem.appendChild(label);

                if (imgUrl) {
                    const img = document.createElement('img');
                    // Add timestamp to prevent browser caching
                    img.src = `${imgUrl}?t=${Date.now()}`;
                    img.className = 'preview-card';
                    img.loading = 'lazy';
                    viewItem.appendChild(img);
                } else {
                    const ph = document.createElement('div');
                    ph.className = 'placeholder-card';
                    ph.textContent = '正在生成预览...';
                    viewItem.appendChild(ph);
                }
                
                list.appendChild(viewItem);
                observer.observe(viewItem);
            });

            $('emptyState').classList.add('hidden');
            list.classList.remove('hidden');
        }

        function highlightSidebar(key) {
            const items = document.querySelectorAll('.slide-item');
            items.forEach(el => {
                if (el.dataset.key === key) {
                    el.classList.add('active');
                    // Scroll sidebar to keep active item in view
                    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    el.classList.remove('active');
                }
            });
        }

        function updateActiveState(key, scrollRightView) {
            // Save current slide modifications before switching
            if (state.activeSlideKey && state.activeSlideKey !== key) {
                saveCurrentSlideModifications();
            }

            state.activeSlideKey = key;

            // 1. Sidebar Highlight
            highlightSidebar(key);

            // 2. Editor & Header
            $('activeSlideTitle').textContent = key;
            const slide = state.slidespec.slides.find(s => s.slide_key === key);
            if (slide) {
                // Check if this slide has pending modifications
                const pendingMods = state.modifiedSlides.get(key);
                const editorContent = pendingMods || slide.placeholders || {};
                $('slideJson').value = JSON.stringify(editorContent, null, 2);
            }

            // Update modified slides count badge
            updateModifiedSlidesUI();

            // 3. Scroll Right View (Only if clicked)
            if (scrollRightView) {
                const viewItem = document.getElementById('view-' + key);
                if (viewItem) {
                    state.isClickScrolling = true;
                    viewItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    // Release lock after animation roughly finishes
                    setTimeout(() => { state.isClickScrolling = false; }, 800);
                }
            }
        }

        // Save current slide modifications to state
        function saveCurrentSlideModifications() {
            if (!state.activeSlideKey) return;

            try {
                const currentJson = $('slideJson').value;
                const editedContent = JSON.parse(currentJson);

                // Find original content
                const slide = state.slidespec.slides.find(s => s.slide_key === state.activeSlideKey);
                if (!slide) return;

                const originalContent = slide.placeholders || {};

                // **IMPORTANT**: Protect token keys from modification
                // Only allow editing VALUES, not KEYS
                // This prevents users from accidentally breaking token references
                const protectedContent = {};

                // Iterate through ORIGINAL keys to preserve them
                for (const originalKey in originalContent) {
                    if (originalKey in editedContent) {
                        // User kept the key, use their edited value
                        protectedContent[originalKey] = editedContent[originalKey];
                    } else {
                        // User deleted the key, keep original to prevent breaking
                        protectedContent[originalKey] = originalContent[originalKey];
                    }
                }

                // Warn if user tried to add new keys (not supported)
                const addedKeys = Object.keys(editedContent).filter(k => !(k in originalContent));
	                if (addedKeys.length > 0) {
	                    console.warn(`Warning: Ignored added keys (not in template): ${addedKeys.join(', ')}`);
	                    toast.warning(
	                        tf('msgIgnoredAddedFields', { fields: addedKeys.join(', ') }),
	                        t('toastTitleHint'),
	                        { duration: 5000 }
	                    );
	                }

                // Check if content has changed
                if (JSON.stringify(protectedContent) !== JSON.stringify(originalContent)) {
                    state.modifiedSlides.set(state.activeSlideKey, protectedContent);
                } else {
                    // Remove from modified if it's been reverted to original
                    state.modifiedSlides.delete(state.activeSlideKey);
                }

	            } catch (e) {
	                console.warn('Failed to save slide modifications:', e);
	                toast.error(t('errorInvalidJsonCannotSave'), t('titleSaveFailed'));
	            }
	        }

        // Update UI to show modified slides count
        function updateModifiedSlidesUI() {
            const count = state.modifiedSlides.size;
            const btn = $('rewriteBtn');

	            if (count > 0) {
	                btn.textContent = tf('btnApplyRegenerateWithCount', { count });
	                btn.style.background = '#f59e0b'; // Orange to indicate pending changes
	            } else {
	                btn.textContent = t('btnApplyRegenerate');
	                btn.style.background = ''; // Reset to default
	            }

            // Add visual indicator to modified slides in sidebar
            document.querySelectorAll('.slide-item').forEach(el => {
                const key = el.dataset.key;
                const indicator = el.querySelector('.modified-indicator');

                if (state.modifiedSlides.has(key)) {
                    if (!indicator) {
	                        const dot = document.createElement('div');
	                        dot.className = 'modified-indicator';
	                        dot.style.cssText = 'width:6px;height:6px;background:#f59e0b;border-radius:50%;margin-left:auto;';
	                        dot.title = t('tooltipModified');
	                        el.appendChild(dot);
	                    }
	                } else {
	                    if (indicator) indicator.remove();
	                }
            });
        }

        function setLoading(flag) {
            state.loading = flag;
            syncActionButtons();
            
            if (flag) {
                $('genIcon').classList.add('hidden');
                $('genSpinner').classList.remove('hidden');
            } else {
                $('genIcon').classList.remove('hidden');
                $('genSpinner').classList.add('hidden');
            }
        }

        function syncActionButtons() {
            $('generateBtn').disabled = state.loading;
            $('rewriteBtn').disabled = state.loading || !state.jobId;
            $('downloadBtn').disabled = state.loading || !state.jobId;
            $('downloadPdfBtn').disabled = state.loading || !state.jobId;
        }

        // --- Actions ---
        $('generateBtn').onclick = async () => {
	            const iId = $('inputSelect').value;
	            const tId = $('templateSelect').value;
	            if (!iId || !tId) {
	                toast.warning(t('msgSelectDataAndTemplate'), t('toastTitleHint'));
	                return;
	            }

            // 前端防抖：检查按钮是否被禁用（冷却中）
            // 从 localStorage 读取冷却结束时间
            const btn = $('generateBtn');
            const cooldownEnd = parseInt(localStorage.getItem('generateCooldownEnd') || '0');
            const now = Date.now();

            if (cooldownEnd > now) {
                const remainingTime = Math.ceil((cooldownEnd - now) / 1000);
                toast.warning(`${t('msgRequestTooFrequent')}${remainingTime} ${t('msgRetryIn')}`, t('msgPleaseWait'));
                return;
            }

            // Check WebSocket connection
            if (!state.wsReady) {
                console.warn('WebSocket not ready, waiting...');
                // Wait for WebSocket to connect (max 3 seconds)
                for (let i = 0; i < 30; i++) {
                    if (state.wsReady) break;
                    await new Promise(resolve => setTimeout(resolve, 100));
                }
                if (!state.wsReady) {
                    console.error('WebSocket connection timeout');
                }
            }

            // Generate session ID only if not already set (for idempotency)
            // This ensures repeated clicks use the same session_id until job completes
            if (!state.sessionId) {
                // Generate session ID with new format: {uuid8}_{timestamp20}
                // Example: a3f2c5d8_20250129143025123456
                const uuid8 = Array.from({length: 8}, () =>
                    Math.floor(Math.random() * 16).toString(16)
                ).join('');
                const nowDate = new Date();
                const timestamp20 =
                    nowDate.getFullYear().toString() +
                    (nowDate.getMonth() + 1).toString().padStart(2, '0') +
                    nowDate.getDate().toString().padStart(2, '0') +
                    nowDate.getHours().toString().padStart(2, '0') +
                    nowDate.getMinutes().toString().padStart(2, '0') +
                    nowDate.getSeconds().toString().padStart(2, '0') +
                    nowDate.getMilliseconds().toString().padStart(3, '0') +
                    Math.floor(Math.random() * 1000).toString().padStart(3, '0'); // Add 3 more digits for microseconds
                state.sessionId = uuid8 + '_' + timestamp20;
                console.log('Generated new session_id:', state.sessionId);
            } else {
                console.log('Reusing existing session_id:', state.sessionId);
            }

            // Show progress panel only for new sessions
            // Don't reset progress if panel is already active (duplicate request)
            const progressPanel = document.getElementById('progressPanel');
            if (!progressPanel.classList.contains('active')) {
                showProgressPanel();
            } else {
                console.log('Progress panel already active, keeping existing progress');
            }

            // 设置冷却时间（与后端同步为30秒）
            const COOLDOWN_SECONDS = 30;
            const cooldownEndTime = Date.now() + (COOLDOWN_SECONDS * 1000);
            localStorage.setItem('generateCooldownEnd', cooldownEndTime.toString());

            // 启动倒计时
            const cooldownInterval = setInterval(() => {
                const cooldownEnd = parseInt(localStorage.getItem('generateCooldownEnd') || '0');
                const remaining = Math.ceil((cooldownEnd - Date.now()) / 1000);
                const btnTextSpan = btn.querySelector('[data-i18n="btnGenerate"]');

                if (remaining <= 0) {
                    clearInterval(cooldownInterval);
                    localStorage.removeItem('generateCooldownEnd');
                    if (btnTextSpan) btnTextSpan.textContent = t('btnGenerate');
                } else {
                    if (btnTextSpan) btnTextSpan.textContent = `${t('btnGenerate')} (${remaining}${t('msgRetryIn')})`;
                }
            }, 1000);

            setLoading(true);
            try {
                await doGenerate(iId, tId, $('useMock').checked);
            } catch (e) {
                console.error(e);

                // 如果出错，清除冷却时间（允许重试）
                clearInterval(cooldownInterval);

                // Check if it's a 429 rate limit error
                if (e.message && e.message.includes('429')) {
                    // Extract remaining seconds from error message if available
                    // Message format: "请求过于频繁，请 N 秒后再试"
                    const match = e.message.match(/(\d+)\s*秒/);
                    if (match) {
                        const serverSeconds = parseInt(match[1]);
                        const newCooldownEnd = Date.now() + (serverSeconds * 1000);
                        localStorage.setItem('generateCooldownEnd', newCooldownEnd.toString());

                        // Restart countdown with server's time
                        const newInterval = setInterval(() => {
                            const cooldownEnd = parseInt(localStorage.getItem('generateCooldownEnd') || '0');
                            const remaining = Math.ceil((cooldownEnd - Date.now()) / 1000);
                            const btnTextSpan = btn.querySelector('[data-i18n="btnGenerate"]');

                            if (remaining <= 0) {
                                clearInterval(newInterval);
                                localStorage.removeItem('generateCooldownEnd');
                                if (btnTextSpan) btnTextSpan.textContent = t('btnGenerate');
                            } else {
                                if (btnTextSpan) btnTextSpan.textContent = `${t('btnGenerate')} (${remaining}${t('msgRetryIn')})`;
                            }
                        }, 1000);

                        toast.warning(e.message, t('msgPleaseWait'));
                        setLoading(false);
                        return; // Don't clear cooldown
                    }
                }

                // For other errors, clear cooldown to allow retry
                localStorage.removeItem('generateCooldownEnd');
                const btnTextSpan = btn.querySelector('[data-i18n="btnGenerate"]');
                if (btnTextSpan) btnTextSpan.textContent = t('btnGenerate');

                // Check if automatic mock retry is suggested
                if (e.data?.error?.auto_retry_with_mock) {
                    // Auto retry with mock
                    try {
                        await doGenerate(iId, tId, true); // Force mock
                    } catch (retryError) {
                        console.error('Mock retry failed:', retryError);
                        handleGenerationFailed({ error: retryError.message });
                    }
                } else {
                    handleGenerationFailed({ error: e.message });
                }
            } finally {
                setLoading(false);
            }
        };

        // Extract generation logic as separate function
        async function doGenerate(inputId, templateId, useMock) {
            // 1. Generate SlideSpec
            const res = await api('/api/v1/reports', {
                method: 'POST',
                body: JSON.stringify({
                    input_id: inputId,
                    template_id: templateId,
                    use_mock: useMock,
                    session_id: state.sessionId,
                    client_id: state.clientId,
                    idempotency_key: state.sessionId  // 使用 session_id 作为幂等性密钥，防止重复提交
                })
            });

            // Extract data from new response format
            const result = res.data || res;

            // Check if this is a duplicate request (job already running or completed)
            if (result.status === 'running') {
                // Job is already running, show toast and don't reset progress
                console.log('Job already running, current progress:', result.progress);
                // Use i18n message (avoid backend hardcoded language)
                const message = t('msgGeneratingPleaseWait');
                toast.info(
                    message,
                    t('toastTitleHint'),
                    { duration: 3000 }
                );
                // Don't reset progress panel, keep existing progress
                return;
            }

            if (result.status === 'completed' && result.from_cache) {
                // Job already completed, use cached result
                console.log('Job already completed, using cached result');
                toast.success(t('msgUsingCachedResult'), t('toastTitleHint'), { duration: 2000 });
                handleGenerationComplete(result);
                return;
            }

            // WebSocket will send completion message with progress updates
            // Only handle result directly if WebSocket is not available (fallback)
            if (!state.websocket || state.websocket.readyState !== WebSocket.OPEN) {
                console.log("WebSocket not connected, handling response directly");
                handleGenerationComplete(result);
            }
            // Otherwise, wait for WebSocket 'completed' message which includes the result
        }

        $('downloadBtn').onclick = () => {
            if (!state.jobId) return;
            // Trigger download
            window.location.href = `/api/v1/reports/${encodeURIComponent(state.jobId)}/download?regenerate_if_missing=true`;
            // Show rating card after a short delay (let download start first)
            setTimeout(() => {
                showRatingCard(state.jobId);
            }, 1000);
        };

        $('downloadPdfBtn').onclick = () => {
            if (!state.jobId) return;
            // Trigger download
            window.location.href = `/api/v1/reports/${encodeURIComponent(state.jobId)}/download-pdf?regenerate_if_missing=true`;
            // Show rating card after a short delay (let download start first)
            setTimeout(() => {
                showRatingCard(state.jobId);
            }, 1000);
        };

        $('rewriteBtn').onclick = async () => {
            if (!state.jobId) return;

            // Save current slide modifications before submitting
            saveCurrentSlideModifications();

	            if (state.modifiedSlides.size === 0) {
	                toast.warning(t('msgNoChangesToApply'), t('toastTitleHint'));
	                return;
	            }

            try {
                setLoading(true);

                // Convert Map to array format for API
                const slidesArray = Array.from(state.modifiedSlides.entries()).map(([slide_key, new_content]) => ({
                    slide_key,
                    new_content
                }));

                console.log(`Submitting ${slidesArray.length} modified slides:`, slidesArray);

                // Use batch rewrite API
                const res = await api(`/api/v1/reports/${encodeURIComponent(state.jobId)}/slides`, {
                    method: 'PATCH',
                    body: JSON.stringify({
                        slides: slidesArray
                    })
                });

                console.log('Rewrite response:', res);

                // Extract data from new response format
                const result = res.data || res;

                // Update Spec with new data
                if (result.slidespec) state.slidespec = result.slidespec;

                // Clear modified slides after successful submission
                state.modifiedSlides.clear();
                updateModifiedSlidesUI();

                // Refresh Previews
                const prevRes = await api(`/api/v1/reports/${encodeURIComponent(state.jobId)}/preview?regenerate_if_missing=true`);
                const prevData = prevRes.data || prevRes;
                state.previews = prevData.preview_urls || prevData.images || [];
                renderPreviewList(); // Refresh images

                // Reload current slide content from updated slidespec
                const slide = state.slidespec.slides.find(s => s.slide_key === state.activeSlideKey);
                if (slide) {
                    $('slideJson').value = JSON.stringify(slide.placeholders || {}, null, 2);
                }

                const l = await api('/api/v1/system/logs?limit=20');
                const logData = l.data || l;
                renderLogs(logData.lines || []);

	                // Show success toast instead of alert
	                toast.success(
	                    tf('msgUpdateSlidesSuccess', { count: result.updated_count || result.updated_slides?.length || 0 }),
	                    t('titleUpdateCompleted')
	                );

	            } catch(e) {
	                toast.error(e.message, t('titleUpdateFailed'));
	                console.error(e);
	            } finally {
	                setLoading(false);
	            }
	        };

        $('toggleLogsBtn').onclick = () => {
            const c = $('logContainer');
            const a = $('logArrow');
            if (c.style.display === 'block') {
                c.style.display = 'none';
                a.style.transform = 'rotate(0deg)';
            } else {
                c.style.display = 'block';
                a.style.transform = 'rotate(180deg)';
            }
        };

        $('refreshPreviewBtn').onclick = async () => {
            if (!state.jobId) return;
            try {
                const prevRes = await api(`/api/v1/reports/${encodeURIComponent(state.jobId)}/preview?regenerate_if_missing=true`);
                const prevData = prevRes.data || prevRes;
                state.previews = prevData.preview_urls || prevData.images || [];
                renderPreviewList();
            } catch (e) {
                console.error('Failed to refresh previews:', e);
            }
        };

        // --- Rating Modal Functions ---
        let ratingState = {
            selectedRating: null,
            jobId: null,
            ratedJobs: new Set()  // Track jobs that have been rated in this session
        };

        function showRatingCard(jobId) {
            // Check if this job has already been rated in this session
            if (ratingState.ratedJobs.has(jobId)) {
                console.log('Job already rated, skipping rating card');
                return;
            }

            ratingState.jobId = jobId;
            ratingState.selectedRating = null;

            // Reset form
            document.querySelectorAll('.rating-btn').forEach(btn => btn.classList.remove('selected'));
            $('ratingCommentSection').style.display = 'none';
            $('ratingComment').value = '';
            $('ratingCharCount').textContent = '0';
            $('submitRatingBtn').style.display = 'none';
            $('submitRatingBtn').disabled = true;
            $('ratingError').style.display = 'none';

            // Show card
            $('ratingCard').style.display = 'block';
        }

        function closeRatingCard() {
            $('ratingCard').style.display = 'none';
        }

        function selectRating(rating) {
            ratingState.selectedRating = rating;

            // Update UI
            document.querySelectorAll('.rating-btn').forEach(btn => btn.classList.remove('selected'));
            document.querySelector(`.rating-btn[data-rating="${rating}"]`).classList.add('selected');

            // Show/hide comment section and submit button
            const commentSection = $('ratingCommentSection');
            const submitBtn = $('submitRatingBtn');

            if (rating === 'disliked') {
                // 点踩：显示评论区和提交按钮
                commentSection.style.display = 'block';
                submitBtn.style.display = 'inline-block';
                submitBtn.disabled = true; // 需要填写评论后才能提交
            } else {
                // 点赞：直接提交评价并关闭弹窗
                submitRating();
            }
        }

        async function submitRating() {
            const rating = ratingState.selectedRating;
            const comment = $('ratingComment').value.trim();
            const errorDiv = $('ratingError');

            // Validate
            if (!rating) {
                showRatingError(t('ratingErrorNoSelection'));
                return;
            }

            if (rating === 'disliked' && comment.length < 10) {
                showRatingError(t('ratingErrorCommentTooShort'));
                return;
            }

            // Submit rating
            try {
                const response = await fetch(`/api/v1/ratings/jobs/${encodeURIComponent(ratingState.jobId)}/rating`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        rating: rating,
                        comment: comment || null
                    })
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.detail || 'Failed to submit rating');
                }

                // Success
                // Mark this job as rated to prevent duplicate rating prompts
                ratingState.ratedJobs.add(ratingState.jobId);
                toast.success(t('ratingSuccessMessage'));
                closeRatingCard();

            } catch (error) {
                showRatingError(error.message);
            }
        }

        function showRatingError(message) {
            const errorDiv = $('ratingError');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }

        // Character counter for comment
        $('ratingComment').addEventListener('input', function() {
            const count = this.value.length;
            $('ratingCharCount').textContent = count;

            // Enable/disable submit button based on comment length
            const rating = ratingState.selectedRating;
            const submitBtn = $('submitRatingBtn');

            if (rating === 'disliked') {
                submitBtn.disabled = count < 10;
            }
        });

        init();
    </script>
</body>
</html>
