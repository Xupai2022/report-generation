[Unit]
Description=MSS AI PPT Backend (RAG enabled)
After=network.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/opt/report-generation
EnvironmentFile=/opt/report-generation/.env
ExecStart=/usr/bin/python3 -m uvicorn mss_ai_ppt_sample_assets.backend.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
